{
  "name": "@lumen/app-ui",
  "version": "0.12.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./appearance": "./src/appearance.ts",
    "./provider": "./src/LumenProvider.tsx",
    "./primitives": "./src/primitives.tsx",
    "./forms": "./src/forms.tsx",
    "./range": "./src/range.tsx",
    "./toggle-button": "./src/toggle-button.tsx",
    "./catalog": "./src/catalog.ts",
    "./variants": "./src/variants/index.ts",
    "./styles.css": "./src/styles.css"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/types/index.d.ts",
        "import": "./dist/index.js"
      },
      "./appearance": {
        "types": "./dist/types/appearance.d.ts",
        "import": "./dist/appearance.js"
      },
      "./provider": {
        "types": "./dist/types/LumenProvider.d.ts",
        "import": "./dist/provider.js"
      },
      "./primitives": {
        "types": "./dist/types/primitives.d.ts",
        "import": "./dist/primitives.js"
      },
      "./forms": {
        "types": "./dist/types/forms.d.ts",
        "import": "./dist/forms.js"
      },
      "./range": {
        "types": "./dist/types/range.d.ts",
        "import": "./dist/range.js"
      },
      "./toggle-button": {
        "types": "./dist/types/toggle-button.d.ts",
        "import": "./dist/toggle-button.js"
      },
      "./catalog": {
        "types": "./dist/types/catalog.d.ts",
        "import": "./dist/catalog.js"
      },
      "./variants": {
        "types": "./dist/types/variants/index.d.ts",
        "import": "./dist/variants.js"
      },
      "./styles.css": "./dist/app-ui.css"
    }
  },
  "scripts": {
    "typescript": "tsc -p tsconfig.json",
    "build": "pnpm typescript && vite build && tsc -p tsconfig.build.json"
  },
  "peerDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/material": "^9.4.0",
    "@tanstack/react-virtual": "^3.14.11",
    "lucide-react": "^1.43.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
